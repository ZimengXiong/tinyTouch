#!/usr/bin/env bash
set -euo pipefail

if ! command -v idf.py >/dev/null 2>&1; then
  printf '%s\n' "ESP-IDF was not found. Install ESP-IDF 5.3.x and source its export.sh." >&2
  exit 1
fi

if ! version_output="$(idf.py --version 2>&1)"; then
  printf '%s\n' "Could not read the ESP-IDF version. Select an ESP-IDF 5.3.x installation." >&2
  exit 1
fi

if [[ ! "$version_output" =~ ESP-IDF[[:space:]]+v?([0-9]+)\.([0-9]+)(\.[0-9]+)? ]]; then
  printf '%s\n' "Could not parse the ESP-IDF version: $version_output" >&2
  printf '%s\n' "tinyTouch requires ESP-IDF 5.3.x." >&2
  exit 1
fi

if [[ "${BASH_REMATCH[1]}" != "5" || "${BASH_REMATCH[2]}" != "3" ]]; then
  printf '%s\n' "Unsupported ESP-IDF version: $version_output" >&2
  printf '%s\n' "tinyTouch requires ESP-IDF 5.3.x. Select its export.sh and build again." >&2
  exit 1
fi

printf '%s\n' "$version_output"
