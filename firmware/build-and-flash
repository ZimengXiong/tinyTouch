#!/bin/zsh
set -euo pipefail

firmware_dir="${0:A:h}/tiny_touch_unified"
selected_port=""
build_only=false

usage() {
  print "Usage: ./firmware/build-and-flash [--build-only] [--port /dev/cu.usbmodem... ]"
  print
  print "Build the unified ESP32-S3 factory firmware and optionally flash one device."
}

while (( $# > 0 )); do
  case "$1" in
    --build-only)
      build_only=true
      shift
      ;;
    --port)
      if (( $# < 2 )); then
        print -u2 "--port needs a device path."
        exit 2
      fi
      selected_port="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      print -u2 "Unknown option: $1"
      usage
      exit 2
      ;;
  esac
done

idf_export=""
if [[ -n "${IDF_PATH:-}" && -f "$IDF_PATH/export.sh" ]]; then
  idf_export="$IDF_PATH/export.sh"
elif [[ -f "$HOME/esp/esp-idf/export.sh" ]]; then
  idf_export="$HOME/esp/esp-idf/export.sh"
fi

if [[ -z "$idf_export" ]]; then
  print -u2 "ESP-IDF was not found."
  print -u2 "Install ESP-IDF 5.3.x, then set IDF_PATH or place it at ~/esp/esp-idf."
  exit 1
fi

print "Step 1 of 3: Load ESP-IDF"
set +u
source "$idf_export" >/dev/null
set -u
idf_version="$("${0:A:h}/check-idf-version")"
print "  ✓ $idf_version"

print
print "Step 2 of 3: Build unified factory firmware"
cd "$firmware_dir"
idf.py build
print "  ✓ Firmware build completed."
print "  Application: $firmware_dir/build/tiny_touch_unified.bin"

if $build_only; then
  print
  print "Build-only mode complete. Nothing was flashed."
  exit 0
fi

if [[ -z "$selected_port" ]]; then
  ports=(/dev/cu.usbmodem*(N) /dev/cu.usbserial*(N))
  if (( ${#ports} == 0 )); then
    print -u2 "No ESP32-S3 serial port was found."
    print -u2 "For a blank board, hold BOOT while connecting USB, then run this command again."
    exit 1
  elif (( ${#ports} == 1 )); then
    selected_port="${ports[1]}"
  else
    print "Connected serial devices:"
    for (( index = 1; index <= ${#ports}; index++ )); do
      print "  $index. ${ports[$index]}"
    done
    if ! read "choice?Choose the ESP32-S3 device number: "; then
      print -u2 "Device selection needs an interactive Terminal. Use --port instead."
      exit 2
    fi
    if [[ "$choice" != <-> ]] || (( choice < 1 || choice > ${#ports} )); then
      print -u2 "That device selection is not valid."
      exit 2
    fi
    selected_port="${ports[$choice]}"
  fi
fi

if [[ ! -e "$selected_port" ]]; then
  print -u2 "The selected port does not exist: $selected_port"
  exit 1
fi

print
print "Step 3 of 3: Flash the factory firmware"
print "  Device: $selected_port"
print "  Do not disconnect it until verification finishes."
idf.py -p "$selected_port" flash
print "  ✓ Firmware was written and verified."
print
print "Factory flash complete."
print "Because the ZW111 stays powered during an MCU reset, unplug and reconnect USB once now."
print "After reconnecting, customer configuration uses only: tinytouch setup"
