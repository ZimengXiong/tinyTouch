def command_add_computer(args: argparse.Namespace) -> None:
    require_macos()
    say("Add this Mac to tinyTouch")
    step(1, 4, "Connect tinyTouch")
    port = choose_port(args.port)
    status = status_fields(port)
    require_unified_firmware(status)
    require_fingerprint_sensor(status)
    mode = status.get("mode")
    if mode not in {"piv", "hid"}:
        raise ToolError("tinyTouch did not report a valid active mode.")
    say(f"Current mode: {mode.upper()}. This Mac will be added for {mode.upper()} only.")

    try:
        fingerprint_count = int(status.get("fingerprints", "0"))
    except ValueError:
        fingerprint_count = 0

    configuration_unlocked = False
    step(2, 4, f"Authorize {mode.upper()} setup")
    if mode == "hid" or status.get("keys") != "nvs" or fingerprint_count == 0:
        unlock_configuration(port)
        configuration_unlocked = True
    else:
        say("Touch your enrolled finger when macOS pairing requests authorization.")

    if status.get("keys") != "nvs":
        port = provision_piv_keys(port, generate_piv_bundle())
        status = status_fields(port)

    step(3, 4, "Check fingerprint")
    if fingerprint_count == 0:
        if not configuration_unlocked:
            unlock_configuration(port)
        enroll_finger_profile(port)
    else:
        verbose(f"preserving {fingerprint_count} enrolled fingerprint views")

    if mode == "hid":
        step(4, 4, "Add HID access for this Mac")
        configure_hid_credentials(port, status)
    else:
        step(4, 4, "Pair PIV with this Mac")
        pair_piv(port=port)
    say()
    say(f"This Mac is ready for {mode.upper()}. The device remains in {mode.upper()} mode.")


def command_computers(args: argparse.Namespace) -> None:
    port = choose_port(args.port)
    status = status_fields(port)
    require_unified_firmware(status)
    if firmware_protocol(status) < 2:
        raise ToolError("Update tinyTouch firmware to manage more than one HID computer.")
    registered_ids, capacity = hid_key_ids(port)
    account = pairing_account_for_port(port)
    local_key_hex = keychain_get(PAIRING_SERVICE, account)
    local_id = None
    if local_key_hex:
        try:
            local_id = hid_key_id(bytes.fromhex(local_key_hex))
        except ValueError:
            pass
    if args.action == "list":
        say(f"HID computers ({len(registered_ids)} of {capacity}):")
        if not registered_ids:
            say("  none")
        for host_id in sorted(registered_ids):
            say(f"  {host_id}" + ("  this Mac" if host_id == local_id else ""))
        say("PIV can be paired independently on each Mac with 'tinytouch pair'.")
        return
    if not args.host_id:
        raise ToolError("Specify the HID computer ID to remove. Run 'tinytouch computers list' first.")
    host_id = args.host_id.lower()
    if not re.fullmatch(r"[0-9a-f]{16}", host_id):
        raise ToolError("HID computer ID must be the 16-character ID shown by 'tinytouch computers list'.")
    if host_id not in registered_ids:
        raise ToolError(f"HID computer {host_id} is not registered on this tinyTouch.")
    unlock_configuration(port)
    serial_command(port, f"HID_KEY_REMOVE {host_id}", timeout=3)
    if host_id == local_id:
        keychain_delete(PAIRING_SERVICE, account)
    say(f"Removed HID computer {host_id}.")


def command_password(args: argparse.Namespace) -> None:
    require_macos()
    port = choose_port(args.port)
    require_unified_firmware(status_fields(port))
    account = pairing_account_for_port(port)
    password_account = (fingerprint_password_account(account, args.fingerprint)
                        if args.fingerprint else account)
    if args.action == "set":
        password = prompt_password()
        keychain_set(PASSWORD_SERVICE, password_account, password)
        del password
        install_helper(ensure_helper_environment())
        label = f"fingerprint {args.fingerprint}" if args.fingerprint else "default"
        say(f"Password updated for {label}.")
        return
    if args.action == "remove":
        if not args.fingerprint:
            raise ToolError("Specify --fingerprint to remove an override; replace the default with 'tinytouch password set'.")
        keychain_delete(PASSWORD_SERVICE, password_account)
        if LAUNCH_AGENT.exists() and not HELPER_SUSPENDED:
            load_helper()
        say(f"Password override removed for fingerprint {args.fingerprint}.")
        return
    say("HID passwords:")
    say(f"  default: {'configured' if keychain_exists(PASSWORD_SERVICE, account) else 'missing'}")
    for slot in range(1, 6):
        state = "custom" if keychain_exists(
            PASSWORD_SERVICE, fingerprint_password_account(account, slot)
        ) else "default"
        say(f"  fingerprint {slot}: {state}")


def command_config(args: argparse.Namespace) -> None:
    port = choose_port(args.port)
    status = status_fields(port)
    require_unified_firmware(status)
    if args.action == "show":
        say(f"Typing delay: {status.get('typing_delay_ms', '7')} ms")
        say(f"Press Enter: {'on' if status.get('submit_enter', '1') == '1' else 'off'}")
        say(f"Touch cooldown: {status.get('touch_cooldown_ms', '800')} ms")
        return
    if not args.setting or args.value is None:
        raise ToolError("Use 'tinytouch config set SETTING VALUE'.")
    protocol_name: str
    protocol_value: int
    if args.setting == "typing-delay":
        protocol_name = "typing_delay_ms"
        try:
            protocol_value = int(args.value)
        except ValueError as exc:
            raise ToolError("Typing delay must be from 1 to 100 milliseconds.") from exc
        if not 1 <= protocol_value <= 100:
            raise ToolError("Typing delay must be from 1 to 100 milliseconds.")
    elif args.setting == "enter":
        protocol_name = "submit_enter"
        if args.value not in {"on", "off"}:
            raise ToolError("Enter must be 'on' or 'off'.")
        protocol_value = 1 if args.value == "on" else 0
    else:
        protocol_name = "touch_cooldown_ms"
        try:
            protocol_value = int(args.value)
        except ValueError as exc:
            raise ToolError("Touch cooldown must be from 100 to 5000 milliseconds.") from exc
        if not 100 <= protocol_value <= 5000:
            raise ToolError("Touch cooldown must be from 100 to 5000 milliseconds.")
    unlock_configuration(port)
    serial_command(port, f"SETTING {protocol_name} {protocol_value}", timeout=3)
    say("Setting updated.")


