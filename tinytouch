def ensure_helper_environment() -> Path:
    if FROZEN:
        return Path(sys.executable)
    python = VENV / "bin" / "python"
    if not python.exists():
        say("Creating helper environment...")
        run([sys.executable, "-m", "venv", str(VENV)])
    dependencies = subprocess.run(
        [str(python), "-c", "import serial"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if dependencies.returncode != 0:
        run([str(python), "-m", "pip", "install", "-q", "-r", str(REQUIREMENTS)])
    return python


def reexec_in_environment_if_needed() -> None:
    if FROZEN:
        return
    if Path(sys.prefix).resolve() == VENV.resolve():
        return
    python = ensure_helper_environment()
    os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])


def launch_agent_contents(python: Path) -> bytes:
    arguments = [str(CLI_INSTALL_PATH), "_helper"] if FROZEN else [str(python), str(HELPER)]
    payload = {
        "Label": "com.tinytouch.helper",
        "ProgramArguments": arguments,
        "RunAtLoad": True,
        "KeepAlive": True,
        "StandardOutPath": "/tmp/tinytouch-helper.log",
        "StandardErrorPath": "/tmp/tinytouch-helper.err",
    }
    return plistlib.dumps(payload, sort_keys=False)


def helper_job_loaded() -> bool:
    result = subprocess.run(
        ["launchctl", "print", f"gui/{os.getuid()}/com.tinytouch.helper"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def helper_processes_running() -> bool:
    patterns = (str(CLI_INSTALL_PATH) + " _helper", str(HELPER))
    return any(
        subprocess.run(
            ["pgrep", "-f", pattern],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode == 0
        for pattern in patterns
    )


def unload_helper() -> bool:
    was_running = helper_job_loaded() or helper_processes_running()
    if not was_running:
        return False
    if LAUNCH_AGENT.exists():
        subprocess.run(
            ["launchctl", "bootout", f"gui/{os.getuid()}", str(LAUNCH_AGENT)],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    patterns = (str(CLI_INSTALL_PATH) + " _helper", str(HELPER))
    for pattern in patterns:
        subprocess.run(
            ["pkill", "-TERM", "-f", pattern],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    deadline = time.monotonic() + 6
    while helper_job_loaded() or helper_processes_running():
        if time.monotonic() >= deadline:
            raise ToolError(
                "The HID background service did not release the serial port. Run "
                "'tinytouch status' again; if this repeats, unplug and reconnect tinyTouch."
            )
        time.sleep(0.05)
    time.sleep(0.15)
    return was_running


def remove_helper() -> None:
    unload_helper()
    LAUNCH_AGENT.unlink(missing_ok=True)


def load_helper() -> None:
    unload_helper()
    run(["launchctl", "bootstrap", f"gui/{os.getuid()}", str(LAUNCH_AGENT)])


def install_helper(python: Path) -> None:
    unload_helper()
    if FROZEN:
        install_command_if_needed()
    LAUNCH_AGENT.parent.mkdir(parents=True, exist_ok=True)
    LAUNCH_AGENT.write_bytes(launch_agent_contents(python))
    if not HELPER_SUSPENDED:
        load_helper()


def prompt_password() -> str:
    say("HID mode needs the password it should type after a fingerprint match.")
    say("It will be stored only in this Mac user's Keychain, separately for this device.")
    try:
        first = getpass.getpass("Enter this Mac account's password: ")
        second = getpass.getpass("Enter it again to confirm: ")
    except EOFError as exc:
        raise ToolError(
            "Password entry needs an interactive Terminal. Open Terminal and run setup again."
        ) from exc
    if not first:
        raise ToolError("Password cannot be empty.")
    if len(first.encode("utf-8")) > 160:
        raise ToolError("Password must be 160 UTF-8 bytes or fewer.")
    if first != second:
        raise ToolError("Passwords did not match.")
    return first


def generate_piv_bundle() -> dict[str, str]:
    common_name = re.sub(r"[^A-Za-z0-9_. -]", "", getpass.getuser()) or "user"
    openssl = Path("/usr/bin/openssl")
    if not openssl.exists():
        raise ToolError("macOS OpenSSL is unavailable, so PIV keys cannot be generated.")
    with tempfile.TemporaryDirectory(prefix="tinytouch-piv-") as temporary_name:
        temporary = Path(temporary_name)
        outputs: dict[str, str] = {}
        for slot, label in (("9a", "authentication"), ("9d", "key management")):
            key = temporary / f"key-{slot}.pem"
            cert = temporary / f"cert-{slot}.pem"
            run(
                [
                    str(openssl), "req", "-newkey", "rsa:2048", "-nodes",
                    "-keyout", str(key), "-x509", "-sha256", "-days", "3650",
                    "-out", str(cert), "-subj", f"/CN=tinyTouch {common_name} {label}/",
                ],
                capture=True,
            )
            outputs[f"key_{slot}"] = key.read_text(encoding="utf-8")
            outputs[f"cert_{slot}"] = cert.read_text(encoding="utf-8")
        return outputs


def run_idf(arguments: list[str]) -> None:
    if shutil.which("idf.py"):
        run([str(ROOT / "firmware" / "check-idf-version")], capture=True)
        run(["idf.py", *arguments], cwd=UNIFIED_FIRMWARE_PROJECT)
        return
    candidates = [
        Path(os.environ.get("IDF_PATH", "")) / "export.sh" if os.environ.get("IDF_PATH") else None,
        Path.home() / "esp" / "esp-idf" / "export.sh",
    ]
    export = next((path for path in candidates if path and path.exists()), None)
    if export is None:
        raise ToolError("idf.py is not available. Source ESP-IDF's export.sh or set IDF_PATH.")
    checker = ROOT / "firmware" / "check-idf-version"
    shell_command = "source {} >/dev/null && {} >/dev/null && idf.py {}".format(
        shlex.quote(str(export)), shlex.quote(str(checker)),
        " ".join(shlex.quote(item) for item in arguments)
    )
    run(
        ["/bin/zsh", "-lc", shell_command],
        cwd=UNIFIED_FIRMWARE_PROJECT,
        display=f"idf.py {' '.join(arguments)}",
    )


def flash_piv(port: str) -> str:
    location = port_usb_location(port)
    download_mode = port_is_download_mode(port)
    if not download_mode:
        fields = status_fields(port)
        if fields.get("firmware") == "unified":
            # Never continue after a failed fingerprint check. BOOTLOADER is
            # configuration-gated, so suppressing this error only turns an
            # actionable authorization failure into a misleading reconnect
            # timeout.
            unlock_configuration(port)
    # sdkconfig fixes the target to ESP32-S3. Re-running set-target here forces
    # a full clean build on every update and delays the touch prompt.
    run_idf(["build"])
    if not download_mode:
        try:
            serial_command(port, "BOOTLOADER", timeout=3)
        except ToolError:
            # USB can detach before the final acknowledgment reaches the host.
            pass
        port = wait_for_download_port(port, location=location)
    run_idf(["-p", port, "flash"])
    return wait_for_runtime_port(location=location)


def is_terminal_response(command: str, line: str) -> bool:
    verb = command.split()[0] if command else ""
    if verb == "PING":
        return line == "PONG" or line.startswith("ERR ")
    if line.startswith(f"OK {verb}") or line.startswith(f"ERR {verb}"):
        return True
    if line.startswith("ERR ") or line == "OK":
        return True
    if line.startswith("OK ") and len(line.split()) >= 2 and line.split()[1] == verb:
        return True
    return False


def serial_command(port: str, command: str, *, timeout: float = 20.0) -> list[str]:
    try:
        import serial  # type: ignore
    except ImportError as exc:
        raise ToolError("pyserial is required. Run 'tinytouch setup' or install requirements.txt.") from exc

    was_loaded = False if HELPER_SUSPENDED else unload_helper()
    lines: list[str] = []
    try:
        try:
            with serial.Serial(port, 115200, timeout=0.25, write_timeout=2) as device:
                time.sleep(0.4)
                device.reset_input_buffer()
                device.write((command + "\n").encode("ascii"))
                device.flush()
                deadline = time.monotonic() + timeout
                while time.monotonic() < deadline:
                    raw = device.readline()
                    if not raw:
                        continue
                    line = raw.decode("utf-8", "replace").strip()
                    if not line:
                        continue
                    lines.append(line)
                    show_device_line(line)
                    if is_terminal_response(command, line):
                        break
        except (OSError, serial.SerialException, termios.error) as exc:
            raise ToolError(serial_failure_message(port, exc)) from exc
    finally:
        if was_loaded:
            load_helper()
    if not lines:
        if port_is_download_mode(port):
            raise ToolError(
                "The ESP32-S3 is in firmware download mode, so the tinyTouch application is not "
                f"running. Flash it at {FACTORY_FLASH_URL}, then unplug and reconnect it."
            )
        raise ToolError(
            "A serial device was found, but it did not answer the tinyTouch command within "
            "the timeout. Confirm that this is the tinyTouch port, unplug and reconnect the "
            "device, then run 'tinytouch status --verbose'."
        )
    if lines[-1].startswith("ERR "):
        raise ToolError(human_device_error(lines[-1]))
    return lines


def serial_exchange(device, command: str, *, timeout: float = 5.0) -> list[str]:
    device.write((command + "\n").encode("ascii"))
    device.flush()
    lines: list[str] = []
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        raw = device.readline()
        if not raw:
            continue
        line = raw.decode("utf-8", "replace").strip()
        if not line:
            continue
        lines.append(line)
        show_device_line(line)
        if is_terminal_response(command, line):
            break
    if not lines:
        raise ToolError("tinyTouch stopped responding during the firmware update.")
    if lines[-1].startswith("ERR "):
        raise ToolError(human_device_error(lines[-1]))
    return lines


def install_ota_firmware(
    port: str, image: bytes, expected_sha256: str, *, chunk_size: int = 360
) -> str:
    commit_sent = False
    try:
        import serial  # type: ignore
    except ImportError as exc:
        raise ToolError("The CLI is missing its serial support. Run the installer again.") from exc

    location = port_usb_location(port)
    say("Touch the sensor to authorize the update. Do not press BOOT.")
    serial_command(port, "UPDATE_UNLOCK", timeout=15)
    token = secrets.token_hex(16)
    try:
        with serial.Serial(port, 115200, timeout=0.25, write_timeout=5) as device:
            time.sleep(0.4)
            device.reset_input_buffer()
            say("Starting firmware write...")
            serial_exchange(device, f"UPDATE_BEGIN {token} {len(image)} {expected_sha256}")
            try:
                total = len(image)
                for offset in range(0, total, chunk_size):
                    chunk = base64.b64encode(image[offset:offset + chunk_size]).decode("ascii")
                    lines = serial_exchange(device, f"UPDATE_CHUNK {token} {offset} {chunk}")
                    expected_next = min(offset + chunk_size, total)
                    match = re.search(r"next=(\d+)", " ".join(lines))
                    if not match or int(match.group(1)) != expected_next:
                        raise ToolError("tinyTouch acknowledged an unexpected firmware offset.")
                    percent = expected_next * 100 // total
                    progress(f"Writing firmware... {percent}% ({expected_next}/{total})")
                progress_done("Firmware written.")
                say("Committing update...")
                commit_sent = True
                serial_exchange(device, f"UPDATE_COMMIT {token}", timeout=8)
            except BaseException:
                progress_done()
                if not commit_sent:
                    try:
                        serial_exchange(device, f"UPDATE_ABORT {token}", timeout=2)
                    except BaseException:
                        pass
                raise
    except (OSError, serial.SerialException, termios.error) as exc:
        # A successful commit restarts USB and can close the port before macOS
        # delivers the final acknowledgment.
        if not commit_sent:
            raise ToolError(serial_failure_message(port, exc)) from exc
        verbose(f"update port closed during restart: {exc}")
    wait_for_port_departure(port)
    return wait_for_runtime_port(location=location, wait_seconds=30)


def migrate_partition_layout(port: str, manifest: dict) -> str:
    try:
        import esptool  # type: ignore
    except ImportError as exc:
        raise ToolError("The CLI is missing its firmware migration support. Run the installer again.") from exc

    factory = manifest.get("firmware", {}).get("factory", {})
    images = factory.get("images", [])
    required = {item.get("file"): item for item in images if isinstance(item, dict)}
    names = ("bootloader.bin", "partition-table.bin", "tiny_touch_unified.bin")
    if any(name not in required for name in names):
        raise ToolError("The release is missing a firmware migration image.")

    location = port_usb_location(port)
    if port_is_download_mode(port):
        say("Device is already in download mode.")
        download_port = port
    else:
        say("Touch the sensor to authorize a one-time flash. This enables later updates without BOOT.")
        unlock_configuration(port)
        say("Switching to download mode...")
        try:
            serial_command(port, "BOOTLOADER", timeout=3)
        except ToolError as exc:
            try:
                download_port = wait_for_download_port(port, location=location, wait_seconds=5)
            except ToolError:
                raise exc
        else:
            download_port = wait_for_download_port(port, location=location)
    say("Downloading factory firmware...")
    payloads = {name: verified_release_asset(required[name], manifest) for name in names}
    migration_state = manifest.get("migration", {}).get("otaState")
    if not isinstance(migration_state, dict):
        raise SupportError("The release is missing its migration state image.")
    payloads["ota_slot1.bin"] = verified_release_asset(migration_state, manifest)
    say("Flashing firmware...")
    with tempfile.TemporaryDirectory(prefix="tinytouch-update-") as directory_name:
        directory = Path(directory_name)
        paths = {}
        for name, payload in payloads.items():
            path = directory / name
            path.write_bytes(payload)
            paths[name] = path
        common = [
            "--chip", "esp32s3", "--port", download_port, "--baud", "460800",
            "--before", "no_reset", "--after", "no_reset", "write_flash",
            "--flash_mode", "dio", "--flash_freq", "80m", "--flash_size", "4MB",
        ]
        stage_arguments = [*common,
            "0x110000", str(paths["tiny_touch_unified.bin"]),
        ]
        activate_arguments = [*common,
            "0x0", str(paths["bootloader.bin"]),
            "0x8000", str(paths["partition-table.bin"]),
            "0x210000", str(paths["ota_slot1.bin"]),
            "0x10000", str(paths["tiny_touch_unified.bin"]),
        ]
        activate_arguments[9] = "hard_reset"
        output = io.StringIO()
        try:
            with contextlib.redirect_stdout(sys.stdout if VERBOSE else output), \
                 contextlib.redirect_stderr(sys.stderr if VERBOSE else output):
                esptool.main(stage_arguments)
                esptool.main(activate_arguments)
        except SystemExit as exc:
            if exc.code not in {None, 0}:
                verbose(output.getvalue())
                raise SupportError("The firmware migration failed. Run 'tinytouch update --verbose'.") from exc
    return wait_for_runtime_port(location=location, wait_seconds=30)


def enroll_finger_profile(port: str) -> None:
    orientations = (
        "center of your finger",
        "left edge of the same finger",
        "right edge of the same finger",
        "fingertip of the same finger",
    )
    for index in range(len(orientations)):
        say(f"Enroll {orientations[index]} ({index + 1} of {len(orientations)}).")
        serial_command(port, f"ENROLL {index + 1}", timeout=45)
    serial_command(port, "PROFILE_COMPLETE 4", timeout=3)


def provision_piv_keys(port: str, bundle: dict[str, str]) -> str:
    say("Creating this device's unique smart-card identity. This does not reflash firmware.")
    serial_command(port, "PROVISION_BEGIN", timeout=3)
    names = {
        "cert_9a": "cert9a",
        "key_9a": "key9a",
        "cert_9d": "cert9d",
        "key_9d": "key9d",
    }
    for source_name, device_name in names.items():
        labels = {
            "cert_9a": "authentication certificate",
            "key_9a": "authentication private key",
            "cert_9d": "key-management certificate",
            "key_9d": "key-management private key",
        }
        say(f"  • Storing {labels[source_name]}...")
        encoded = base64.b64encode(bundle[source_name].encode("utf-8")).decode("ascii")
        for offset in range(0, len(encoded), 480):
            serial_command(
                port,
                f"PROVISION_CHUNK {device_name} {encoded[offset:offset + 480]}",
                timeout=3,
            )
    serial_command(port, "PROVISION_COMMIT", timeout=5)
    say("  ✓ Unique PIV identity stored on tinyTouch.")
    location = port_usb_location(port)
    try:
        serial_command(port, "USB_RECONNECT", timeout=3)
    except ToolError:
        # A quick USB detach can race the final acknowledgment.
        pass
    # USB_RECONNECT is acknowledged before the USB detach. Do not rediscover the
    # still-present old device node during that short interval.
    time.sleep(1.0)
    return wait_for_runtime_port(location=location)


def unlock_configuration(port: str) -> None:
    verbose("requesting fingerprint authorization")
    serial_command(port, "CONFIG_UNLOCK", timeout=15)
    verbose("configuration authorized for two minutes")


def provision_hid_key(port: str, key: bytes) -> None:
    if len(key) != 32:
        raise ToolError("The HID pairing key must be 32 bytes.")
    serial_command(port, f"HID_KEY {key.hex()}", timeout=3)
    say("  ✓ A unique HID pairing key is stored on tinyTouch.")


def hid_key_id(key: bytes) -> str:
    return hashlib.sha256(key).hexdigest()[:16]


def hid_key_ids(port: str) -> tuple[set[str], int]:
    lines = serial_command(port, "HID_KEY_IDS", timeout=3)
    line = next((item for item in lines if item.startswith("OK HID_KEY_IDS ")), "")
    fields = dict(re.findall(r"([A-Za-z_]+)=([^ ]+)", line))
    ids = set() if fields.get("ids") in {None, "none"} else set(fields["ids"].split(","))
    try:
        capacity = int(fields.get("capacity", "0"))
    except ValueError:
        capacity = 0
    return ids, capacity


def firmware_protocol(status: dict[str, str]) -> int:
    try:
        return int(status.get("protocol", "1"))
    except ValueError:
        return 1


def pair_piv(requested_identity: str | None = None, port: str | None = None) -> None:
    say("Waiting for macOS to discover tinyTouch's smart-card identity...")
    output = ""
    for _ in range(20):
        try:
            output = run(["sc_auth", "identities"], capture=True)
        except ToolError:
            output = ""
        identities = []
        for line in output.splitlines():
            match = re.search(r"\b([0-9A-Fa-f]{40})\b\s*(.*)", line)
            if match:
                identities.append((match.group(1), match.group(2).strip()))
        authentication_identities = [
            item for item in identities if "authentication" in item[1].lower()
        ]
        if authentication_identities:
            identities = authentication_identities
        identities = list(dict.fromkeys(identities))
        hashes = [identity_hash for identity_hash, _ in identities]
        if hashes:
            if requested_identity:
                matches = [value for value in hashes if value.lower() == requested_identity.lower()]
                if not matches:
                    raise ToolError(
                        f"Identity {requested_identity} is not currently available.\n{output.strip()}"
                    )
                identity = matches[0]
            elif len(hashes) == 1:
                identity = hashes[0]
            else:
                say("Multiple smart-card identities are available:")
                for index, (value, label) in enumerate(identities, 1):
                    say(f"  {index}. {value}  {label}".rstrip())
                choice = ask(
                    "Identity to pair [1]: ",
                    noninteractive_hint=(
                        "Multiple smart-card identities were found. Run 'tinytouch pair "
                        "--identity HASH' with the identity shown above."
                    ),
                ).strip() or "1"
                try:
                    identity = hashes[int(choice) - 1]
                except (ValueError, IndexError):
                    raise ToolError("Invalid identity selection.") from None
            say(f"Pairing with macOS account '{getpass.getuser()}'.")
            if port:
                say("Touch your enrolled finger when requested.")
                serial_command(port, "PAIRING_MODE", timeout=15)
            say()
            say("macOS may show three prompts:")
            say("  1. Terminal Password — your normal Mac password")
            say("  2. Smart Card PIN — 000000 (six zeros)")
            say("  3. Keychain/System Password — your normal Mac password again")
            try:
                try:
                    run(["sudo", "sc_auth", "pair", "-u", getpass.getuser(), "-h", identity])
                except ToolError as exc:
                    verbose(f"pairing failure: {exc}")
                    detail = str(exc)
                    if "6982" in detail:
                        raise ToolError(
                            "macOS pairing was not authorized in time. Run 'tinytouch pair' "
                            "again, touch an enrolled finger when instructed, and use 000000 "
                            "at the smart-card PIN prompt."
                        ) from exc
                    if "CryptoTokenKit" in detail:
                        raise ToolError(
                            "macOS lost communication with the smart card. Unplug tinyTouch, "
                            "reconnect it, wait five seconds, and run 'tinytouch pair' again."
                        ) from exc
                    raise ToolError(
                        "macOS could not pair the smart-card identity. Run the command again "
                        "with --verbose for diagnostic details."
                    ) from exc
            finally:
                if port:
                    try:
                        serial_command(port, "PAIRING_MODE_OFF", timeout=3)
                    except ToolError:
                        pass
            say("  ✓ This macOS account is paired with tinyTouch.")
            return
        time.sleep(0.5)
    raise ToolError(
        "macOS did not discover the smart-card identity. Unplug tinyTouch, reconnect it, "
        "wait a few seconds, and run 'tinytouch pair'."
    )


def install_factory_firmware(port: str) -> str:
    if FROZEN:
        raise ToolError(
            "This ESP32-S3 does not have compatible unified firmware. Flash it at "
            f"{FACTORY_FLASH_URL}, unplug and reconnect it, then run 'tinytouch setup' again."
        )
    ensure_helper_environment()  # provides pyserial for configuration commands
    say("Installing the unified factory firmware (development operation)...")
    return flash_piv(port)


def status_fields(port: str) -> dict[str, str]:
    lines = serial_command(port, "STATUS", timeout=3)
    status_line = next((line for line in reversed(lines) if line.startswith("OK STATUS ")), "")
    if not status_line:
        raise ToolError(
            "The device answered, but its STATUS response is not a recognized tinyTouch "
            "response. It may be running unrelated or very old firmware."
        )
    fields = dict(re.findall(r"([A-Za-z_]+)=([^ ]+)", status_line))
    if "mode" not in fields:
        raise ToolError(
            "The device returned an incomplete STATUS response without a runtime mode. "
            "Reflash the unified firmware and try again."
        )
    return fields


def require_unified_firmware(status: dict[str, str]) -> None:
    if status.get("firmware") == "unified":
        return
    if status.get("mode") in {"hid", "piv"}:
        raise ToolError(
            "Older tinyTouch firmware was detected. It cannot provision unique keys or switch "
            f"modes at runtime. Flash the unified firmware at {FACTORY_FLASH_URL}, unplug and "
            "reconnect the device, then run setup again."
        )
    raise ToolError(
        "The connected serial device is not reporting itself as unified tinyTouch firmware. "
        "If this is the correct ESP32-S3, flash the factory firmware and try again."
    )


def require_fingerprint_sensor(status: dict[str, str]) -> None:
    if status.get("sensor") == "ok":
        return
    raise ToolError(
        "The unified tinyTouch firmware is running, but the fingerprint sensor did not respond.\n"
        "Check the sensor connections:\n"
        "  1. Sensor power is 3.3 V and ground is connected.\n"
        "  2. Sensor TX connects to ESP32-S3 GPIO44.\n"
        "  3. Sensor RX connects to ESP32-S3 GPIO43.\n"
        "TOUCH_OUT on GPIO2 is not required for this status check."
    )


def configure_hid_credentials(port: str, status: dict[str, str]) -> None:
    python = ensure_helper_environment()
    account = pairing_account_for_port(port)
    device_has_key = status.get("hid_key") == "configured"
    local_key_hex = keychain_get(PAIRING_SERVICE, account)
    try:
        local_key = bytes.fromhex(local_key_hex) if local_key_hex else None
    except ValueError:
        local_key = None
    if local_key is not None and len(local_key) != 32:
        local_key = None
    local_has_password = keychain_exists(PASSWORD_SERVICE, account)

    if firmware_protocol(status) >= 2:
        registered_ids, capacity = hid_key_ids(port)
        if local_key is None:
            local_key = secrets.token_bytes(32)
        local_id = hid_key_id(local_key)
        if local_id not in registered_ids:
            if capacity and len(registered_ids) >= capacity:
                raise ToolError(
                    f"This tinyTouch already trusts {capacity} HID computers. Remove an old "
                    "computer with 'tinytouch computers remove HID_ID', then try again."
                )
            serial_command(port, f"HID_KEY_ADD {local_id} {local_key.hex()}", timeout=3)
            say(f"  ✓ This Mac was added as HID computer {local_id}.")
        else:
            say(f"  ✓ This Mac is already trusted for HID ({local_id}).")
        keychain_set(PAIRING_SERVICE, account, local_key.hex())
    else:
        if device_has_key and local_key is None:
            raise ToolError(
                "This device uses older single-computer HID firmware, and its existing key "
                "belongs to another Mac. Update the firmware before adding this Mac; the "
                "update preserves the existing key."
            )
        if not device_has_key:
            local_key = local_key or secrets.token_bytes(32)
            provision_hid_key(port, local_key)
            keychain_set(PAIRING_SERVICE, account, local_key.hex())
            say("  ✓ Matching HID key stored in this Mac user's Keychain.")

    if not local_has_password:
        password = prompt_password()
        keychain_set(PASSWORD_SERVICE, account, password)
        del password
    install_helper(python)
    say("  ✓ Background HID service installed for this Mac user.")


def configure_unified_device(
    args: argparse.Namespace, mode: str, port: str, status: dict[str, str],
    *, first_step: int, total_steps: int,
) -> None:
    require_unified_firmware(status)
    require_fingerprint_sensor(status)
    try:
        fingerprint_count = int(status.get("fingerprints", "0"))
    except ValueError:
        fingerprint_count = 0
    try:
        fingerprint_profile = int(status.get("fingerprint_profile", "0"))
    except ValueError:
        fingerprint_profile = 0

    local_hid_ready = False
    if mode == "hid":
        account = pairing_account_for_port(port)
        local_hid_ready = False
        local_key_hex = keychain_get(PAIRING_SERVICE, account)
        if local_key_hex and keychain_exists(PASSWORD_SERVICE, account):
            if firmware_protocol(status) >= 2:
                try:
                    registered_ids, _ = hid_key_ids(port)
                    local_hid_ready = hid_key_id(bytes.fromhex(local_key_hex)) in registered_ids
                except (ToolError, ValueError):
                    local_hid_ready = False
            else:
                local_hid_ready = status.get("hid_key") == "configured"

    changes_needed = (
        status.get("keys") != "nvs"
        or status.get("mode") != mode
        or (not args.skip_enroll and fingerprint_profile != 4)
        or (mode == "hid" and not local_hid_ready)
    )
    step(first_step, total_steps, "Secure this device")
    if changes_needed:
        unlock_configuration(port)
    if status.get("keys") != "nvs":
        say("Creating this device's unique keys...")
        port = provision_piv_keys(port, generate_piv_bundle())
        status = status_fields(port)
        if status.get("keys") != "nvs":
            raise ToolError("The device did not load its provisioned PIV keys.")

    if mode == "hid":
        configure_hid_credentials(port, status)

    step(first_step + 1, total_steps, "Set up fingerprint")
    if not args.skip_enroll:
        if fingerprint_profile == 4:
            verbose("preserving the four-view fingerprint profile")
        else:
            if fingerprint_count:
                answer = ask(
                    "Replace the existing fingerprint enrollment with four views? [y/N] ",
                    noninteractive_hint="Run setup in a terminal to approve fingerprint replacement.",
                )
                if answer.lower() not in {"y", "yes"}:
                    raise ToolError("Fingerprint enrollment was not changed.")
            enroll_finger_profile(port)
    else:
        say("Fingerprint enrollment was skipped as requested.")

    step(first_step + 2, total_steps, f"Finish {mode.upper()} setup")
    if status.get("mode") != mode:
        serial_command(port, f"MODE {mode}", timeout=3)
        say(f"  ✓ {mode.upper()} mode enabled.")
    if mode == "piv" and not args.no_pair:
        pair_piv(port=port)
    elif mode == "piv":
        say("macOS smart-card pairing was skipped as requested.")
    location = port_usb_location(port)
    try:
        serial_command(port, "USB_RECONNECT", timeout=3)
    except ToolError:
        pass
    time.sleep(1.0)
    wait_for_runtime_port(location=location)
    say(f"tinyTouch is ready in {mode.upper()} mode.")


def command_setup(args: argparse.Namespace) -> None:
    require_macos()
    say("Setting up tinyTouch...")
    mode = choose_mode(args.mode)
    step(1, 4, "Connect tinyTouch")
    port = choose_port(args.port)
    say(f"Found tinyTouch on {port}.")
    if port_is_download_mode(port):
        port = install_factory_firmware(port)
        status = status_fields(port)
    else:
        try:
            status = status_fields(port)
        except ToolError as exc:
            raise ToolError(
                f"tinyTouch was found on {port}, but setup could not read its status.\n"
                f"Reason: {exc}"
            ) from exc
    if status.get("firmware") != "unified":
        if FROZEN:
            require_unified_firmware(status)
        port = install_factory_firmware(port)
        status = status_fields(port)
    require_unified_firmware(status)
    require_fingerprint_sensor(status)
    configure_unified_device(args, mode, port, status, first_step=2, total_steps=4)


def command_mode(args: argparse.Namespace) -> None:
