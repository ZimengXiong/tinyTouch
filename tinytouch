            [str(Path(sys.executable).resolve()), "_helper", "--self-test", "--device-id", device_account]
            if FROZEN
            else [str(python), str(HELPER), "--self-test", "--device-id", device_account]
        )
        result = subprocess.run(
            command, check=False
        )
        if result.returncode != 0:
            raise ToolError(
