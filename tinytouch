                "tinyTouch. Use --verbose if the test still fails."
            )
        say("  ✓ HID background service and Keychain credentials work.")
    elif mode == "piv":
        if status.get("keys") != "nvs":
            say("PIV identity is not provisioned yet; run 'tinytouch setup'.")
