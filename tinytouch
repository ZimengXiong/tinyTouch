def command_update(args: argparse.Namespace) -> None:
    require_macos()
    if getattr(args, "local", False):
        bin_path = Path(args.local if isinstance(args.local, str) and args.local != "True" else "firmware/tiny_touch_unified/build/tiny_touch_unified.bin").resolve()
        if not bin_path.is_file():
            say("Building local firmware...")
            run_idf(["build"])
        if not bin_path.is_file():
            raise ToolError(f"Firmware binary not found: {bin_path}")
        image = bin_path.read_bytes()
        sha = hashlib.sha256(image).hexdigest()
        version = (ROOT / "VERSION").read_text(encoding="utf-8").strip()
        manifest = {
            "version": version,
            "build": git_short_sha(),
            "ota": {"sha256": sha, "size": len(image)},
        }
    else:
        manifest = release_manifest()
        if update_installed_cli(manifest, announce=True):
            os.execv(str(CLI_INSTALL_PATH), [str(CLI_INSTALL_PATH), *sys.argv[1:]])
    port = choose_port(args.port)
    if port_is_download_mode(port):
        port = migrate_partition_layout(port, manifest)
    status = status_fields(port)
    require_unified_firmware(status)
    require_fingerprint_sensor(status)
    if (
        not getattr(args, "force", False)
        and
        firmware_protocol(status) >= 3
        and status.get("ota") == "ready"
        and status.get("firmware_version") == manifest.get("version")
        and status.get("build") == manifest.get("build")
    ):
        say("tinyTouch is up to date.")
        return
    if firmware_protocol(status) < 3 or status.get("ota") != "ready":
        port = migrate_partition_layout(port, manifest)
        status = status_fields(port)
        if firmware_protocol(status) < 3 or status.get("ota") != "ready":
            raise SupportError("tinyTouch restarted, but its update system is not ready.")
    else:
        metadata = manifest.get("ota")
        if not isinstance(metadata, dict):
            raise ToolError("This release does not include a firmware update.")
        if getattr(args, "local", False):
            say(f"Flashing local firmware {bin_path.name} ({len(image)} bytes)...")
        else:
            say("Downloading firmware update...")
            image = verified_release_asset(metadata, manifest)
        protocol = firmware_protocol(status)
        chunk_size = 3072 if protocol >= 4 else 360
        port = install_ota_firmware(port, image, metadata["sha256"], chunk_size=chunk_size)
        status = status_fields(port)
    if status.get("firmware_version") != manifest.get("version") or status.get("build") != manifest.get("build"):
        diagnostics = " ".join(
            f"{name}={status[name]}"
            for name in ("ota_running", "ota_boot", "ota_next", "ota_slot0", "ota_slot1")
            if name in status
        )
        raise SupportError(
            "tinyTouch restarted with an unexpected firmware version "
            f"(expected {manifest.get('version')}/{manifest.get('build')}, "
            f"got {status.get('firmware_version', 'unknown')}/{status.get('build', 'unknown')})."
            + (f" OTA diagnostics: {diagnostics}" if diagnostics else "")
        )
    try:
        serial_command(port, f"CONFIRM_FIRMWARE {manifest['build']}", timeout=3)
    except ToolError:
        pass
    time.sleep(1)
    confirmed_status = status_fields(port)
    require_fingerprint_sensor(confirmed_status)
    if confirmed_status.get("build") != manifest.get("build"):
        raise SupportError("tinyTouch did not remain on the expected firmware build.")
    say("tinyTouch is up to date.")


def command_flash_local(args: argparse.Namespace) -> None:
