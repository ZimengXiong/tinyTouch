    new_status = status_fields(port)
    say(f"tinyTouch successfully updated to {new_status.get('firmware_version')} (build {new_status.get('build')}, running slot {new_status.get('ota_running')})!")


def command_pair(args: argparse.Namespace) -> None:
    require_macos()
    say("Pair tinyTouch with this macOS account")
    port = choose_port(args.port)
    status = status_fields(port)
    require_unified_firmware(status)
    require_fingerprint_sensor(status)
    pair_piv(args.identity, port)


def command_keys(args: argparse.Namespace) -> None:
    require_macos()
    say("Rotate tinyTouch's PIV identity")
    say("This invalidates the current smart-card pairing on every Mac.")
    port = choose_port(args.port)
    status = status_fields(port)
    require_unified_firmware(status)
    require_fingerprint_sensor(status)
    if not args.yes:
        answer = ask(
            "Rotate the PIV identity and invalidate existing pairings? Type 'rotate keys': ",
            noninteractive_hint=(
                "Key rotation requires confirmation in an interactive Terminal, or use --yes."
            ),
        )
        if answer.strip().lower() != "rotate keys":
            raise ToolError("Key rotation cancelled.")
    unlock_configuration(port)
    say("Generating a new unique PIV identity.")
    port = provision_piv_keys(port, generate_piv_bundle())
    status = status_fields(port)
    if status.get("keys") != "nvs":
        raise ToolError("The rotated keys were not loaded after restart.")
    say("PIV keys rotated successfully.")
    say("Run 'tinytouch pair' on every Mac that should continue using this device.")


def command_factory_reset(args: argparse.Namespace) -> None:
    require_macos()
    say("Factory-reset tinyTouch")
    port = choose_port(args.port)
    status = status_fields(port)
    require_unified_firmware(status)
    require_fingerprint_sensor(status)
    if not args.yes:
        answer = ask(
            "Erase all device keys, settings, and fingerprints? Type 'factory reset': ",
            noninteractive_hint=(
                "Factory reset requires confirmation in an interactive Terminal, or use --yes."
            ),
        )
        if answer.strip().lower() != "factory reset":
            raise ToolError("Factory reset cancelled.")
    say("Factory reset will permanently erase device keys, settings, and fingerprints.")
    say("Authorize the reset with an enrolled fingerprint.")
    serial_command(port, "PAIRING_MODE", timeout=15)
    serial_command(port, "FACTORY_RESET", timeout=10)
    account = pairing_account_for_port(port)
    keychain_delete(PASSWORD_SERVICE, account)
    keychain_delete(PAIRING_SERVICE, account)
    location = port_usb_location(port)
    try:
        serial_command(port, "USB_RECONNECT", timeout=3)
    except ToolError:
        pass
    time.sleep(1.0)
    wait_for_runtime_port(location=location)
    say("Factory reset complete.")
    say("The device is now unconfigured. Run 'tinytouch setup' to use it again.")


def command_bootloader(args: argparse.Namespace) -> None:
    port = choose_port(args.port)
    fields = status_fields(port)
    require_unified_firmware(fields)
    require_fingerprint_sensor(fields)
    unlock_configuration(port)
    serial_command(port, "BOOTLOADER", timeout=3)
    say("tinyTouch entered firmware download mode.")


def command_delete(args: argparse.Namespace) -> None:
    say("Delete enrolled fingerprint data")
    if args.all and not args.yes:
        answer = ask(
            "Delete every enrolled fingerprint? Type 'delete all': ",
            noninteractive_hint=(
                "Deleting all fingerprints requires an interactive Terminal, or use --yes."
            ),
        ).strip().lower()
        if answer != "delete all":
            raise ToolError("Fingerprint deletion cancelled.")
    command = "DELETE_ALL" if args.all else f"DELETE {args.slot}"
    port = choose_port(args.port)
    status = status_fields(port)
    require_unified_firmware(status)
    require_fingerprint_sensor(status)
    say("Authorize fingerprint changes with an enrolled finger.")
    unlock_configuration(port)
    serial_command(port, command)
    say("All fingerprints were deleted." if args.all else f"Fingerprint slot {args.slot} was deleted.")


def command_logs(args: argparse.Namespace) -> None:
    say("tinyTouch HID background-service logs")
    paths = [Path("/tmp/tinytouch-helper.log"), Path("/tmp/tinytouch-helper.err")]
    for path in paths:
        say(f"==> {path} <==")
        if not path.exists():
            say("(missing)")
            continue
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        say("\n".join(lines[-args.lines :]))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="tinytouch", description=__doc__)
    result.add_argument("--version", action="version", version=f"tinyTouch CLI {CLI_VERSION}")
    result.add_argument(
        "--verbose", action="store_true",
        help="show shell commands, serial protocol messages, and diagnostic details",
    )
    sub = result.add_subparsers(dest="command", required=True)

    def add_verbose_option(command_parser: argparse.ArgumentParser) -> None:
        command_parser.add_argument(
            "--verbose", action="store_true", default=argparse.SUPPRESS,
            help="show shell commands, serial protocol messages, and diagnostic details",
        )

    setup = sub.add_parser("setup", help="provision, enroll, pair, and select a mode")
    add_verbose_option(setup)
    setup.add_argument("--mode", choices=("hid", "piv"), help="choose a mode without the menu")
    setup.add_argument("--port", help="use a specific /dev/cu.* device")
    setup.add_argument("--skip-enroll", action="store_true", help="do not enroll a fingerprint")
    setup.add_argument("--no-pair", action="store_true", help="do not pair PIV with the current Mac user")
    setup.set_defaults(func=command_setup)

    mode = sub.add_parser("mode", help="switch runtime mode without reflashing")
    add_verbose_option(mode)
    mode.add_argument("mode", choices=("hid", "piv"), help="mode to activate")
    mode.add_argument("--port", help="use a specific /dev/cu.* device")
    mode.add_argument("--skip-enroll", action="store_true", help="do not enroll a missing fingerprint")
    mode.add_argument("--no-pair", action="store_true", help="do not pair PIV with macOS")
    mode.set_defaults(func=command_mode)

    add_computer = sub.add_parser(
        "add-computer", help="add this Mac to the device's current PIV or HID mode"
    )
    add_verbose_option(add_computer)
    add_computer.add_argument("--port", help="use a specific /dev/cu.* device")
    add_computer.set_defaults(func=command_add_computer)

    computers = sub.add_parser("computers", help="list or remove trusted HID computers")
    add_verbose_option(computers)
    computers.add_argument("action", choices=("list", "remove"))
    computers.add_argument("host_id", nargs="?", help="ID shown by 'tinytouch computers list'")
    computers.add_argument("--port", help="use a specific /dev/cu.* device")
    computers.set_defaults(func=command_computers)

    password = sub.add_parser("password", help="manage the HID password")
    add_verbose_option(password)
    password.add_argument("action", choices=("set", "remove", "list"))
    password.add_argument("--fingerprint", type=int, choices=range(1, 6),
                          help="use a separate password for this fingerprint slot")
    password.add_argument("--port", help="use a specific /dev/cu.* device")
    password.set_defaults(func=command_password)

    config = sub.add_parser("config", help="show or change HID behavior")
    add_verbose_option(config)
    config.add_argument("action", choices=("show", "set"))
    config.add_argument("setting", nargs="?", choices=("typing-delay", "enter", "cooldown"))
    config.add_argument("value", nargs="?")
    config.add_argument("--port", help="use a specific /dev/cu.* device")
    config.set_defaults(func=command_config)

    keyboard_layout = sub.add_parser(
        "keyboard-layout", help="choose how HID passwords map to keys"
    )
    add_verbose_option(keyboard_layout)
    keyboard_layout.add_argument("layout", choices=("auto", "us"))
    keyboard_layout.add_argument("--port", help="use a specific /dev/cu.* device")
    keyboard_layout.set_defaults(func=command_keyboard_layout)

    status = sub.add_parser("status", help="show device and host status")
    add_verbose_option(status)
    status.add_argument("--port", help="use a specific /dev/cu.* device")
    status.set_defaults(func=command_status)

    test = sub.add_parser("test", help="ping the device and test the HID helper")
    add_verbose_option(test)
    test.add_argument("--port", help="use a specific /dev/cu.* device")
    test.set_defaults(func=command_test)

    enroll = sub.add_parser("enroll", help="enroll four views of one finger")
    add_verbose_option(enroll)
    enroll.add_argument("--slot", type=int, choices=range(1, 6),
                        help="advanced: replace one fingerprint slot")
    enroll.add_argument("--port", help="use a specific /dev/cu.* device")
    enroll.set_defaults(func=command_enroll)

    update = sub.add_parser("update", help="update the CLI and firmware")
    add_verbose_option(update)
    update.add_argument("--force", action="store_true",
                        help="rewrite the current release to test OTA slot switching")
    update.add_argument("--local", nargs="?", const=True,
                        help="flash locally built firmware binary without release")
    update.add_argument("--port", help="use a specific /dev/cu.* device")
    update.set_defaults(func=command_update)

    pair = sub.add_parser("pair", help="pair the current Mac user with the attached PIV device")
    add_verbose_option(pair)
    pair.add_argument("--identity", help="40-character identity hash from 'sc_auth identities'")
    pair.add_argument("--port", help="use a specific /dev/cu.* device")
    pair.set_defaults(func=command_pair)

    keys = sub.add_parser("keys", help="rotate customer PIV keys without rebuilding firmware")
    add_verbose_option(keys)
    keys.add_argument("--yes", action="store_true", help="rotate without confirmation")
    keys.add_argument("--port", help="use a specific /dev/cu.* device")
    keys.set_defaults(func=command_keys)

    factory_reset = sub.add_parser(
        "factory-reset", help="erase device keys, settings, and fingerprints"
    )
    add_verbose_option(factory_reset)
    factory_reset.add_argument("--yes", action="store_true", help="reset without typed confirmation")
    factory_reset.add_argument("--port", help="use a specific /dev/cu.* device")
    factory_reset.set_defaults(func=command_factory_reset)

    if not FROZEN:
        bootloader = sub.add_parser(
            "bootloader", help="development only: restart in firmware download mode"
        )
        add_verbose_option(bootloader)
        bootloader.add_argument("--port", help="use a specific /dev/cu.* device")
        bootloader.set_defaults(func=command_bootloader)

    delete = sub.add_parser("delete", help="delete a fingerprint")
    add_verbose_option(delete)
    delete_group = delete.add_mutually_exclusive_group(required=True)
    delete_group.add_argument("--slot", type=int, choices=range(1, 6))
    delete_group.add_argument("--all", action="store_true")
    delete.add_argument("--yes", action="store_true", help="confirm --all without prompting")
    delete.add_argument("--port", help="use a specific /dev/cu.* device")
    delete.set_defaults(func=command_delete)

    logs = sub.add_parser("logs", help="show helper logs")
    add_verbose_option(logs)
    logs.add_argument("--lines", type=int, default=40)
    logs.set_defaults(func=command_logs)

    flash_local = sub.add_parser("flash-local", help="flash a local firmware binary over OTA (developer command)")
    add_verbose_option(flash_local)
    flash_local.add_argument("binary", help="path to tiny_touch_unified.bin")
    flash_local.add_argument("--port", help="use a specific /dev/cu.* device")
    flash_local.set_defaults(func=command_flash_local)
    return result


def main() -> int:
    global VERBOSE, HELPER_SUSPENDED
    if FROZEN and len(sys.argv) > 1 and sys.argv[1] == "_helper":
        sys.argv = ["tinytouch-helper", *sys.argv[2:]]
        from tinytouch_helper import main as helper_main  # type: ignore

        helper_main()
        return 0
    if FROZEN and len(sys.argv) > 1 and sys.argv[1] == "_package_test":
        import certifi  # type: ignore  # noqa: F401
        import serial  # type: ignore  # noqa: F401
        import esptool  # type: ignore  # noqa: F401
        import tinytouch_helper  # type: ignore  # noqa: F401
        import tinytouch_keychain  # type: ignore  # noqa: F401
        from esptool.targets.esp32s3 import ESP32S3ROM  # type: ignore  # noqa: F401

        say(f"package ok ({platform.machine()})")
        return 0
    if FROZEN and len(sys.argv) > 1 and sys.argv[1] == "_network_test":
        channel = json.loads(download_bytes(RELEASE_CHANNEL_URL).decode("utf-8"))
        if not isinstance(channel.get("manifest"), str):
            raise SupportError("The tinyTouch release channel is incomplete.")
        say("network ok")
        return 0
    if FROZEN and len(sys.argv) > 1 and sys.argv[1] == "_auto_update":
        auto_update_cli(force=True)
        return 0
    install_command_if_needed()
    args = parser().parse_args()
    VERBOSE = args.verbose
    if args.command != "update":
        schedule_auto_update()
    device_commands = {
        "setup", "mode", "add-computer", "computers", "status", "test", "enroll", "pair", "keys",
        "factory-reset", "delete", "bootloader", "update", "password", "config",
        "keyboard-layout", "flash-local",
    }
    helper_was_loaded = os.environ.pop("_TINYTOUCH_RESTART_HELPER", "") == "1"
    try:
        show_startup_mark()
        if args.command in device_commands:
            reexec_in_environment_if_needed()
            helper_was_loaded = unload_helper() or helper_was_loaded
            if helper_was_loaded:
                os.environ["_TINYTOUCH_RESTART_HELPER"] = "1"
            HELPER_SUSPENDED = True
        args.func(args)
        return 0
    except (ToolError, KeyboardInterrupt, EOFError) as exc:
        message = str(exc) or "cancelled"
        print(f"tinytouch: {message}", file=sys.stderr)
        if isinstance(exc, SupportError):
            print(f"Contact {SUPPORT_EMAIL} if this continues.", file=sys.stderr)
        return 1
    finally:
        if HELPER_SUSPENDED:
            HELPER_SUSPENDED = False
            helper_installing_commands = {"setup", "mode", "add-computer", "password"}
            if LAUNCH_AGENT.exists() and (
                helper_was_loaded or args.command in helper_installing_commands
            ):
                try:
                    load_helper()
                except ToolError as exc:
                    print(f"tinytouch: HID background service could not restart: {exc}", file=sys.stderr)


if __name__ == "__main__":
    raise SystemExit(main())
