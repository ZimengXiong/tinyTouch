def download_bytes(url: str, *, timeout: float = 10.0) -> bytes:
    verbose(f"download: {url}")
    request = urllib.request.Request(url, headers={"User-Agent": f"tinytouch/{CLI_VERSION}"})
    try:
        with urllib.request.urlopen(request, timeout=timeout, context=TLS_CONTEXT) as response:
            return response.read()
    except (OSError, urllib.error.URLError) as exc:
        verbose(f"download failed: {exc!r}")
        raise ToolError("Could not reach the tinyTouch update service. Check your connection and try again.") from exc


def release_manifest() -> dict:
    try:
        local_directory = os.environ.get("TINYTOUCH_LOCAL_RELEASE_DIR")
        if local_directory:
            manifest = json.loads(
                (Path(local_directory).expanduser() / "release-manifest.json").read_text(
                    encoding="utf-8"
                )
            )
        else:
            channel = json.loads(download_bytes(RELEASE_CHANNEL_URL).decode("utf-8"))
            manifest_url = channel.get("manifest")
            if not isinstance(manifest_url, str) or not manifest_url.startswith(
                "https://github.com/ZimengXiong/TinyTouch/releases/download/"
            ):
                raise ValueError("invalid channel manifest URL")
            manifest = json.loads(download_bytes(manifest_url).decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
        raise SupportError("The tinyTouch update manifest is invalid.") from exc
    if not isinstance(manifest.get("version"), str) or not isinstance(manifest.get("firmware"), dict):
        raise SupportError("The tinyTouch update manifest is incomplete.")
    return manifest


def release_base_url(manifest: dict) -> str:
    version = manifest.get("version")
    if not isinstance(version, str) or not re.fullmatch(r"[0-9A-Za-z._-]+", version):
        raise SupportError("The tinyTouch update manifest has an invalid version.")
    return f"https://github.com/ZimengXiong/TinyTouch/releases/download/v{version}"


def verified_release_asset(metadata: dict, manifest: dict) -> bytes:
    name = metadata.get("file")
    expected = metadata.get("sha256")
    if not isinstance(name, str) or not isinstance(expected, str):
        raise SupportError("The tinyTouch update manifest is missing an asset checksum.")
    local_directory = os.environ.get("TINYTOUCH_LOCAL_RELEASE_DIR")
    if local_directory:
        try:
            payload = (Path(local_directory).expanduser() / name).read_bytes()
        except OSError as exc:
            raise SupportError(f"Local release asset is missing: {name}") from exc
    else:
        payload = download_bytes(
            f"{release_base_url(manifest)}/{name}?sha256={expected}", timeout=30.0
        )
    if len(payload) != metadata.get("size") or hashlib.sha256(payload).hexdigest() != expected:
        raise SupportError(f"{name} failed its integrity check. Nothing was installed.")
    return payload


def git_short_sha() -> str:
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--short=12", "HEAD"],
            cwd=str(ROOT),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=True,
        )
        return proc.stdout.strip()
    except Exception:
        return "development"


def update_installed_cli(manifest: dict, *, announce: bool) -> bool:
    if not FROZEN:
        return False
    machine = platform.machine()
    if machine == "x86_64" and sys.platform == "darwin":
        translated = subprocess.run(
            ["/usr/sbin/sysctl", "-in", "sysctl.proc_translated"],
            check=False, text=True, capture_output=True,
        )
        if translated.stdout.strip() == "1":
            machine = "arm64"
    architecture = {"arm64": "macos-arm64", "x86_64": "macos-x86_64"}.get(machine)
    if architecture is None:
        raise ToolError(f"This Mac architecture is not supported: {platform.machine()}.")
    metadata = manifest.get("cli", {}).get(architecture)
    if not isinstance(metadata, dict):
        raise ToolError("This release does not include a CLI update.")
    marker = SUPPORT_DIR / "installed-cli-sha256"
    try:
        if marker.read_text(encoding="ascii").strip() == metadata.get("sha256"):
            return False
    except OSError:
        pass
    if metadata.get("format") != "tar.gz":
        raise SupportError("The CLI update has an unsupported package format.")
    if announce:
        say("Downloading CLI...")
    payload = verified_release_asset(metadata, manifest)
    if announce:
        say("Installing CLI...")
    bundle = SUPPORT_DIR / f"cli-{metadata['sha256'][:16]}"
    if not bundle.exists():
        SUPPORT_DIR.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix="tinytouch-cli-", dir=SUPPORT_DIR) as directory:
            staging = Path(directory)
            with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as archive:
                archive.extractall(staging, filter="data")
            extracted = staging / "tinytouch"
            executable = extracted / "tinytouch"
            if not executable.is_file() or not (extracted / "_internal").is_dir():
                raise SupportError("The CLI update package is incomplete.")
            extracted.replace(bundle)
    executable = bundle / "tinytouch"
    CLI_INSTALL_DIR.mkdir(parents=True, exist_ok=True)
    temporary = CLI_INSTALL_PATH.with_suffix(".update")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(executable)
    temporary.replace(CLI_INSTALL_PATH)
    marker.write_text(metadata["sha256"] + "\n", encoding="ascii")
    if announce:
        say("CLI updated.")
    return True


def auto_update_cli(*, force: bool = False) -> bool:
    if not FROZEN:
        return False
    check_file = SUPPORT_DIR / "last-update-check"
    try:
        if not force and time.time() - check_file.stat().st_mtime < 6 * 60 * 60:
            return False
    except OSError:
        pass
    try:
        updated = update_installed_cli(release_manifest(), announce=False)
        SUPPORT_DIR.mkdir(parents=True, exist_ok=True)
        check_file.touch()
        return updated
    except ToolError as exc:
        verbose(f"automatic CLI update skipped: {exc}")
        return False


def schedule_auto_update() -> None:
    if not FROZEN:
        return
    check_file = SUPPORT_DIR / "last-update-check"
    try:
        if time.time() - check_file.stat().st_mtime < 6 * 60 * 60:
            return
    except OSError:
        pass
    SUPPORT_DIR.mkdir(parents=True, exist_ok=True)
    check_file.touch()
    with open(os.devnull, "wb") as devnull:
        subprocess.Popen(
            [sys.executable, "_auto_update"], stdin=devnull, stdout=devnull, stderr=devnull,
            start_new_session=True,
        )


def wait_for_port_departure(port: str, *, wait_seconds: int = 10) -> None:
    say("Waiting for tinyTouch to restart...")
    deadline = time.monotonic() + wait_seconds
    while time.monotonic() < deadline:
        if port not in detect_ports():
            return
        time.sleep(0.1)
    raise SupportError("tinyTouch did not restart after accepting the firmware update.")


def install_command_if_needed() -> None:
    """Install the frozen CLI on PATH without interrupting the requested command."""
    if not FROZEN:
        return
    source = Path(sys.executable).resolve()
    installed = False
    if source != CLI_INSTALL_PATH.resolve():
        CLI_INSTALL_DIR.mkdir(parents=True, exist_ok=True)
        if (source.parent / "_internal").is_dir():
            digest = hashlib.sha256(source.read_bytes()).hexdigest()[:16]
            bundle = SUPPORT_DIR / f"cli-local-{digest}"
            if not bundle.exists():
                SUPPORT_DIR.mkdir(parents=True, exist_ok=True)
                staging = SUPPORT_DIR / f".cli-local-{digest}"
                if staging.exists():
                    shutil.rmtree(staging)
                shutil.copytree(source.parent, staging)
                staging.replace(bundle)
            target = bundle / source.name
            temporary = CLI_INSTALL_PATH.with_suffix(".tmp")
            temporary.unlink(missing_ok=True)
            temporary.symlink_to(target)
            temporary.replace(CLI_INSTALL_PATH)
        elif not CLI_INSTALL_PATH.exists() or not filecmp.cmp(source, CLI_INSTALL_PATH, shallow=False):
            # Compatibility for the old one-file pre-production CLI.
            temporary = CLI_INSTALL_PATH.with_suffix(".tmp")
            shutil.copy2(source, temporary)
            temporary.chmod(0o755)
            try:
                os.removexattr(temporary, "com.apple.quarantine")
            except (AttributeError, OSError):
                pass
            temporary.replace(CLI_INSTALL_PATH)
        installed = True

    path_added = False
    shell_name = Path(os.environ.get("SHELL", "/bin/zsh")).name
    if shell_name == "fish":
        profile = Path.home() / ".config" / "fish" / "config.fish"
        path_line = 'fish_add_path "$HOME/.local/bin" # tinyTouch\n'
    elif shell_name == "bash":
        profile = Path.home() / ".bash_profile"
        path_line = 'export PATH="$HOME/.local/bin:$PATH" # tinyTouch\n'
    else:
        profile = Path.home() / ".zprofile"
        path_line = 'export PATH="$HOME/.local/bin:$PATH" # tinyTouch\n'
    existing = profile.read_text(encoding="utf-8") if profile.exists() else ""
    if ".local/bin" not in existing:
        profile.parent.mkdir(parents=True, exist_ok=True)
        with profile.open("a", encoding="utf-8") as handle:
            if existing and not existing.endswith("\n"):
                handle.write("\n")
            handle.write(path_line)
        path_added = True
    local_bin = str(CLI_INSTALL_DIR)
    if local_bin not in os.environ.get("PATH", "").split(os.pathsep):
        os.environ["PATH"] = local_bin + os.pathsep + os.environ.get("PATH", "")

    if installed or path_added:
        say("Installed command: tinytouch")
        if path_added:
            say("Future Terminal windows can run it from anywhere.")


def ask(prompt: str, *, noninteractive_hint: str | None = None) -> str:
    try:
        return input(prompt)
    except EOFError as exc:
        hint = noninteractive_hint or (
            "This step needs an answer, but Terminal input is unavailable. "
            "Open Terminal and run the command there."
        )
        raise ToolError(hint) from exc


