def say(message: str = "") -> None:
    print(message, flush=True)


def progress(message: str) -> None:
    if sys.stdout.isatty():
        sys.stdout.write("\r" + message + "\033[K")
        sys.stdout.flush()
        return
    say(message)


def progress_done(message: str = "") -> None:
    if sys.stdout.isatty():
        sys.stdout.write("\r\033[K")
        sys.stdout.flush()
    if message:
        say(message)


