#!/bin/zsh
set -euo pipefail

project_dir="${0:A:h:h}"
cd "$project_dir"

version="$(tr -d '[:space:]' < VERSION)"
tag="v$version"
commit="$(git rev-parse HEAD)"

git diff --quiet -- && git diff --cached --quiet -- || {
  print -u2 "Tracked and staged files must be clean before creating a release tag."
  exit 1
}
[[ "$(git branch --show-current)" = main ]] || {
  print -u2 "Release tags must be created from main."
  exit 1
}
git fetch --quiet origin main
[[ "$commit" = "$(git rev-parse origin/main)" ]] || {
  print -u2 "Local main must match origin/main."
  exit 1
}
! git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null || {
  print -u2 "Tag $tag already exists locally."
  exit 1
}

repository="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
settings="$(gh api \
  -H 'Accept: application/vnd.github+json' \
  -H 'X-GitHub-Api-Version: 2026-03-10' \
  "repos/$repository/immutable-releases")" || {
  print -u2 "Repository immutable releases must be enabled before tagging."
  exit 1
}
[[ "$(jq -r .enabled <<<"$settings")" = true ]] || exit 1

deadline=$((SECONDS + 600))
run_id=""
while (( SECONDS < deadline )); do
  runs="$(gh api \
    "repos/$repository/actions/workflows/release-candidate.yml/runs?branch=main&event=push&per_page=100")"
  run_id="$(jq -r --arg sha "$commit" \
    '[.workflow_runs[] | select(.head_sha == $sha and .head_branch == "main" and .event == "push" and .conclusion == "success")] | first | .id // empty' \
    <<<"$runs")"
  [[ -n "$run_id" ]] && break
  terminal="$(jq -r --arg sha "$commit" \
    '[.workflow_runs[] | select(.head_sha == $sha and .head_branch == "main" and .event == "push" and .status == "completed") | .conclusion] | first // empty' \
    <<<"$runs")"
  if [[ -n "$terminal" && "$terminal" != success ]]; then
    print -u2 "Release candidate for $commit ended with: $terminal"
    exit 1
  fi
  print "Waiting for release candidate $commit..."
  sleep 10
done
[[ -n "$run_id" ]] || {
  print -u2 "Timed out after 600s waiting for the release candidate for $commit."
  exit 1
}
artifact="release-candidate-$commit"
count="$(gh api "repos/$repository/actions/runs/$run_id/artifacts" | jq \
  --arg name "$artifact" '[.artifacts[] | select(.name == $name and .expired == false)] | length')"
[[ "$count" = 1 ]] || {
  print -u2 "The exact release candidate artifact is missing or expired."
  exit 1
}

git tag -a "$tag" -m "tinyTouch $version"
git push origin "refs/tags/$tag"
